{% extends "base.html.j2" %}
{% block content %}
<h2 id="Recordings">Recordings</h2>
<p class="desc">One line per recording; open one for its alignment, who is on camera, measures, review frames and warnings.</p>
<table class="flat">
  <thead><tr><th>Recording</th><th class="num">Fail</th><th class="num">Warn</th><th class="num">Info</th><th>Waiting for a person</th></tr></thead>
  <tbody>
  {%- for row in recordings %}
  <tr><td><a href="{{ row.href }}">{{ row.recording_id }}</a></td>
    <td class="num">{% if row.counts.fail %}<span class="bad">{{ row.counts.fail }}</span>{% else %}<span class="na">0</span>{% endif %}</td>
    <td class="num">{% if row.counts.warn %}<span class="warn">{{ row.counts.warn }}</span>{% else %}<span class="na">0</span>{% endif %}</td>
    <td class="num">{{ row.counts.info }}</td>
    <td>{{ row.waiting | join(", ") }}</td></tr>
  {%- endfor %}
  </tbody>
</table>
{% if frame_rates %}
<h2 id="Rates">Frame rates</h2>
<p class="desc"><span class="warn">The videos run at different frame rates.</span> Motion energy counts what changed from one frame to the next, so the same movement gives less of it at a higher rate: compare it only between videos at one rate{% if common_rate %}, or set video.fps: {{ "%g" | format(common_rate) }} to bring every video to that rate{% else %}; no one rate divides all of them by a whole number, so video.fps cannot bring them together{% endif %}.</p>
<table class="flat">
  <thead><tr><th class="num">Frames per second</th><th class="num">Videos</th><th class="num">Recordings</th></tr></thead>
  <tbody>
  {%- for row in frame_rates %}
  <tr><td class="num">{{ row.fps }}</td><td class="num">{{ row.videos }}</td><td class="num">{{ row.recordings }}</td></tr>
  {%- endfor %}
  </tbody>
</table>
{% endif %}
{% endblock %}
